# 仅本机演示值；不放入真实凭据。复制后通过 shell/Compose 注入。
HTTP_ADDR=127.0.0.1:8080
DATABASE_DSN=app:local-development-db@tcp(127.0.0.1:3306)/ai_backend?parseTime=true
JWT_SECRET=local-development-only-change-this-32-byte-secret
JWT_TTL=1h
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_CONN_LIFETIME=5m
MONTHLY_TOKEN_LIMIT=100000
REDIS_ADDR=127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=mock-doc-qa
LLM_TIMEOUT=30s
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
DATA_DIR=./data
