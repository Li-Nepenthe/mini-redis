["GET" "binary"] => "$6\r\na\r\nb\x00c\r\n"
["GET" "persistent"] => "$4\r\nkept\r\n"
["TTL" "persistent"] => ":-1\r\n"
["GET" "deleted"] => "$-1\r\n"
["GET" "zero"] => "$-1\r\n"
["LRANGE" "list" "0" "-1"] => "*2\r\n$1\r\nb\r\n$1\r\na\r\n"
["TTL" "list"] => ":90\r\n"
["LRANGE" "drained" "0" "-1"] => "*0\r\n"
["TTL" "drained"] => ":-2\r\n"
["LRANGE" "reborn-list" "0" "-1"] => "*1\r\n$3\r\nnew\r\n"
["TTL" "reborn-list"] => ":-1\r\n"
["GET" "reborn-string"] => "$3\r\nnew\r\n"
["TTL" "reborn-string"] => ":-1\r\n"
["GET" "expired"] => "$-1\r\n"
["TTL" "expired"] => ":-2\r\n"
["GET" "renewed"] => "$4\r\nkept\r\n"
["TTL" "renewed"] => ":90\r\n"
["LRANGE" "was-string" "0" "-1"] => "*1\r\n$3\r\nnew\r\n"
["TTL" "was-string"] => ":-1\r\n"
["LRANGE" "legacy-list" "0" "-1"] => "*1\r\n$6\r\nlegacy\r\n"
["TTL" "legacy-list"] => ":-1\r\n"
["EXISTS" "binary" "binary" "persistent" "list" "reborn-list" "reborn-string" "renewed" "was-string" "legacy-list"] => ":9\r\n"
["EXISTS" "deleted" "zero" "drained" "expired" "missing"] => ":0\r\n"
